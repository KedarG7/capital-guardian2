PORT=5001
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/capital-guardian
JWT_SECRET=replace-with-a-long-random-secret

# Frontend (Vite reads this from the repo root)
VITE_API_URL=http://localhost:5001/api

# Google OAuth (authorized redirect URI must match exactly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

# Email OTP (required for email/password sign-in)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Capital Guardian <no-reply@example.com>"
